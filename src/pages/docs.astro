---
import { PaperBaseLayout, PaperContentIndex } from "astro-theme-papyrus/components";
import { site } from "../site.config";

const docs = [
  {
    title: "Blog",
    description: "The consuming site keeps only its own posts. Theme demo posts live in papyrus.",
    children: [
      { title: "Hello papyrus", href: "/posts/hello-papyrus/" },
      { title: "Posts", href: "/posts/" },
      { title: "Timeline", href: "/timeline/" },
    ],
  },
  {
    title: "Site pages",
    description: "Thin Astro routes that import papyrus components and local Marcelo data.",
    children: [
      { title: "Projects", href: "/projects/" },
      { title: "About", href: "/about/" },
      { title: "Profile", href: "/profile/" },
      { title: "Printable CV", href: "/profile/print/" },
      { title: "Search", href: "/search/" },
    ],
  },
];
---

<PaperBaseLayout
  title={`Docs | ${site.title}`}
  description={site.description}
  siteTitle={site.title}
  headerTitle={site.headerTitle}
  defaultThemeProfile={site.defaultThemeProfile}
  defaultFontProfile={site.defaultFontProfile}
  nav={site.nav}
  socialLinks={site.socialLinks}
>
  <section class="paper-hero">
    <h1>Docs</h1>
    <p class="paper-description">A small Pure-style content index for the current blog structure.</p>
  </section>

  <PaperContentIndex items={docs} />
</PaperBaseLayout>
