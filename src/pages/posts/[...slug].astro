---
import { getCollection, render } from "astro:content";
import { PaperPostLayout } from "astro-theme-papyrus/components";
import { getAdjacentPosts, postSlug, postTags, publishedPosts, readingTime, routablePosts } from "astro-theme-papyrus/utils";
import { site } from "../../site.config";

export async function getStaticPaths() {
  const allPosts = await getCollection("posts");
  const posts = routablePosts(allPosts);
  const adjacentPosts = publishedPosts(allPosts);
  return posts.map(post => ({
    params: { slug: postSlug(post) },
    props: { post, adjacent: getAdjacentPosts(adjacentPosts, post.id) },
  }));
}

const { post, adjacent } = Astro.props;
const { Content, headings } = await render(post);
const sourcePath = post.filePath?.replace(/^.*?(src\/content\/posts\/)/, "$1") ?? `src/content/posts/${post.id}`;
const sourceLinkUrl = `https://github.com/marcelofpfelix/marcelofelix/blob/main/${sourcePath}`;
const sourceUrl = `https://raw.githubusercontent.com/marcelofpfelix/marcelofelix/main/${sourcePath}`;
---

<PaperPostLayout
  title={post.data.title}
  description={post.data.description}
  pubDatetime={post.data.pubDatetime}
  modDatetime={post.data.modDatetime}
  cover={post.data.cover}
  tags={postTags(post)}
  readingTime={readingTime(post.body)}
  headings={headings}
  showToc={true}
  previous={adjacent.previous}
  next={adjacent.next}
  robots={post.data.robots}
  sourceUrl={sourceUrl}
  sourceLinkUrl={sourceLinkUrl}
  backHref={false}
  siteTitle={site.title}
  headerTitle={site.headerTitle}
  defaultThemeProfile={site.defaultThemeProfile}
  defaultFontProfile={site.defaultFontProfile}
  nav={site.nav}
  socialLinks={site.socialLinks}
  googleVerification={site.googleVerification}
>
  <Content />
</PaperPostLayout>
