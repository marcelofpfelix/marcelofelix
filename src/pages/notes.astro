---
import { getCollection } from "astro:content";
import { PaperBaseLayout, PaperNoteList } from "paper-pure/components";
import { site } from "../site.config";

const notes = (await getCollection("notes"))
  .sort((a, b) => new Date(b.data.date ?? 0).valueOf() - new Date(a.data.date ?? 0).valueOf());
---

<PaperBaseLayout
  title={`Notes | ${site.title}`}
  description={site.description}
  siteTitle={site.title}
  headerTitle={site.headerTitle}
  nav={site.nav}
  socialLinks={site.socialLinks}
>
  <section class="paper-hero">
    <h1>Notes</h1>
    <p class="paper-description">Short tricks and small observations.</p>
  </section>

  <PaperNoteList notes={notes} />
</PaperBaseLayout>
