---
import { PaperBaseLayout, PaperProjectList } from "astro-theme-papyrus/components";
import { projects } from "../data/projects";
import { site } from "../site.config";
---

<PaperBaseLayout
  title={`Projects | ${site.title}`}
  description={site.description}
  siteTitle={site.title}
  headerTitle={site.headerTitle}
  defaultThemeProfile={site.defaultThemeProfile}
  defaultFontProfile={site.defaultFontProfile}
  nav={site.nav}
  socialLinks={site.socialLinks}
  googleVerification={site.googleVerification}
>
  <section class="paper-hero">
    <h1>Projects</h1>
    <p class="paper-description">Pinned tools, experiments, and repos.</p>
  </section>

  <section aria-labelledby="projects-list-heading">
    <h2 id="projects-list-heading" class="sr-only">Project list</h2>
    <PaperProjectList projects={projects} />
  </section>
</PaperBaseLayout>
