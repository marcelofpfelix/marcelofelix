---
import { PaperBaseLayout } from "astro-theme-papyrus/components";
import { withBase } from "astro-theme-papyrus/utils";
import { profile } from "../data/profile";
import { site } from "../site.config";
---

<PaperBaseLayout
  title={`About | ${site.title}`}
  description={site.description}
  siteTitle={site.title}
  headerTitle={site.headerTitle}
  defaultThemeProfile={site.defaultThemeProfile}
  defaultFontProfile={site.defaultFontProfile}
  nav={site.nav}
  socialLinks={site.socialLinks}
  googleVerification={site.googleVerification}
>
  <section class="paper-hero">
    <h1>About</h1>
    <p class="paper-description">{profile.headline}</p>
  </section>

  <section class="paper-section">
    <h2>Whoami</h2>
    <p>
      I work around telecom, infrastructure, local-first tooling, and developer automation.
      This site keeps the writing separate from the reusable theme package, so posts stay portable.
    </p>
    <p class="paper-actions">
      <a href={withBase("/profile/")}>Profile</a>
      <a href={withBase("/profile/print/")}>A4 CV</a>
      <a href={profile.canonicalCv}>Canonical CV</a>
    </p>
  </section>
</PaperBaseLayout>
