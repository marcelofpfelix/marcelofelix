---
import { getCollection } from "astro:content";
import { PapyrusArchiveList, PapyrusBaseLayout } from "astro-theme-papyrus/components";
import { publishedPosts } from "astro-theme-papyrus/utils";
import { site } from "../site.config";

const posts = publishedPosts(await getCollection("posts"));
---

<PapyrusBaseLayout
  title={`Timeline | ${site.title}`}
  description={site.description}
  siteTitle={site.title}
  headerTitle={site.headerTitle}
  defaultThemeProfile={site.defaultThemeProfile}
  defaultFontProfile={site.defaultFontProfile}
  nav={site.nav}
  socialLinks={site.socialLinks}
  googleVerification={site.googleVerification}
>
  <section class="papyrus-hero">
    <h1>Timeline</h1>
    <p class="papyrus-description">All published posts by year.</p>
  </section>

  <PapyrusArchiveList posts={posts} />
</PapyrusBaseLayout>
