---
import { getCollection } from "astro:content";
import { PaperBaseLayout, PaperTagList } from "astro-theme-papyrus/components";
import { getAllTags, postTags, publishedPosts, withBase } from "astro-theme-papyrus/utils";
import { site } from "../../site.config";

const posts = publishedPosts(await getCollection("posts"));
const tags = getAllTags(posts);
const counts = Object.fromEntries(
  tags.map(tag => [tag, posts.filter(post => postTags(post).includes(tag)).length])
);
---

<PaperBaseLayout
  title={`Tags | ${site.title}`}
  description="Browse posts by tag."
  siteTitle={site.title}
  headerTitle={site.headerTitle}
  defaultThemeProfile={site.defaultThemeProfile}
  defaultFontProfile={site.defaultFontProfile}
  nav={site.nav}
  socialLinks={site.socialLinks}
  googleVerification={site.googleVerification}
>
  <section class="paper-hero">
    <p class="paper-post-back">
      <a href={withBase("/posts/")}>
        <svg aria-hidden="true" viewBox="0 0 24 24">
          <path d="M19 12H5"></path>
          <path d="m12 19-7-7 7-7"></path>
        </svg>
        <span>Back</span>
      </a>
    </p>
    <h1>Tags</h1>
    <p class="paper-description">Browse posts by tag.</p>
  </section>

  <section class="paper-section">
    <PaperTagList tags={tags} counts={counts} />
  </section>
</PaperBaseLayout>
