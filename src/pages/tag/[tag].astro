---
import { getCollection } from "astro:content";
import { PaperBaseLayout, PaperPostList } from "astro-theme-papyrus/components";
import { getAllTags, postsByTag, publishedPosts, tagSlug, withBase } from "astro-theme-papyrus/utils";
import { cvSections } from "../../data/profile";
import { site } from "../../site.config";

export async function getStaticPaths() {
  const posts = publishedPosts(await getCollection("posts"));
  const profileTags = cvSections.flatMap(section =>
    section.groups.flatMap(group => group.items.flatMap(item => item.tags ?? []))
  );
  const tags = Array.from(new Set([...getAllTags(posts), ...profileTags]));

  return tags.map(tag => ({
    params: { tag: tagSlug(tag) },
    props: {
      posts: postsByTag(posts, tag),
      tag,
    },
  }));
}

const { posts, tag } = Astro.props;
---

<PaperBaseLayout
  title={`#${tag} | ${site.title}`}
  description={`Posts tagged ${tag}.`}
  siteTitle={site.title}
  headerTitle={site.headerTitle}
  defaultThemeProfile={site.defaultThemeProfile}
  defaultFontProfile={site.defaultFontProfile}
  nav={site.nav}
  socialLinks={site.socialLinks}
  googleVerification={site.googleVerification}
>
  <section class="paper-hero">
    <p class="paper-post-back">
      <a href={withBase("/tag/")}>
        <svg aria-hidden="true" viewBox="0 0 24 24">
          <path d="M19 12H5"></path>
          <path d="m12 19-7-7 7-7"></path>
        </svg>
        <span>Back</span>
      </a>
    </p>
    <h1>#{tag}</h1>
    <p class="paper-description">Posts using this tag.</p>
  </section>

  <section class="paper-section">
    {posts.length > 0 ? (
      <PaperPostList posts={posts} showTags={false} showFirstTagWhenTagsHidden={false} />
    ) : (
      <div class="paper-search-empty">
        <p>No public posts use this tag yet.</p>
      </div>
    )}
  </section>
</PaperBaseLayout>
