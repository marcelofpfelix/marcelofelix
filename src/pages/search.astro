---
import { getCollection } from "astro:content";
import "@pagefind/default-ui/css/ui.css";
import { PaperBaseLayout, PaperTagList } from "astro-theme-papyrus/components";
import { formatPostDate, getAllTags, hiddenPosts, postHref, postTags, publishedPosts, sortPosts } from "astro-theme-papyrus/utils";
import { site } from "../site.config";

const allPosts = await getCollection("posts");
const publicPosts = publishedPosts(allPosts);
const archivedPosts = hiddenPosts(allPosts);
const postCategory = (post: (typeof allPosts)[number]) => post.data.category?.trim() || "";
const categories = Array.from(new Set(publicPosts.map(postCategory).filter(Boolean))).sort();
const tags = getAllTags(publicPosts);
const categoryCounts = Object.fromEntries(
  categories.map(category => [category, publicPosts.filter(post => postCategory(post) === category).length])
);
const counts = Object.fromEntries(
  tags.map(tag => [tag, publicPosts.filter(post => postTags(post).includes(tag)).length])
);
const archivePosts = sortPosts(archivedPosts).map((post) => ({
  title: post.data.title,
  description: post.data.description ?? "",
  href: postHref(post),
  category: postCategory(post),
  tags: postTags(post),
  date: formatPostDate(post.data.pubDatetime),
}));
const archivePostsJson = JSON.stringify(archivePosts).replace(/</g, "\\u003c");
---

<PaperBaseLayout
  title={`Search | ${site.title}`}
  description="Search blog posts by title, description, category, or tag."
  siteTitle={site.title}
  headerTitle={site.headerTitle}
  defaultThemeProfile={site.defaultThemeProfile}
  defaultFontProfile={site.defaultFontProfile}
  nav={site.nav}
  socialLinks={site.socialLinks}
  googleVerification={site.googleVerification}
>
  <section class="paper-search">
    <h1>Search</h1>
    <nav class="paper-search-tags" aria-label="Sections">
      {
        categories.map(category => (
          <button type="button" data-paper-search-category={category}>
            <span>{category}</span>
            <small>{categoryCounts[category]}</small>
          </button>
        ))
      }
    </nav>
    <div class="paper-search-tag-list" aria-label="Tags">
      <PaperTagList tags={tags} counts={counts} />
    </div>
    <div id="pagefind-search" data-pagefind-bundle="/pagefind/"></div>
    <ul class="paper-post-list" data-paper-archive-results hidden></ul>
    <script is:inline type="application/json" id="paper-archive-posts" set:html={archivePostsJson}></script>
  </section>
</PaperBaseLayout>

<script>
  // @ts-expect-error - Pagefind does not ship TypeScript declarations for the default UI package.
  import { PagefindUI } from "@pagefind/default-ui";

  interface ArchivePost {
    title: string;
    description: string;
    href: string;
    category: string;
    tags: string[];
    date: string;
  }

  const archivePosts = JSON.parse(document.querySelector("#paper-archive-posts")?.textContent ?? "[]") as ArchivePost[];
  const pagefindContainer = document.querySelector<HTMLElement>("#pagefind-search");
  const archiveResults = document.querySelector<HTMLElement>("[data-paper-archive-results]");
  const categoryButtons = document.querySelectorAll<HTMLButtonElement>("[data-paper-search-category]");

  function renderArchive(query = "") {
    if (!archiveResults || !pagefindContainer) return;

    const normalized = query.trim().toLowerCase();
    const matches = normalized
      ? archivePosts.filter((post) => [post.title, post.description, post.category, ...post.tags].join(" ").toLowerCase().includes(normalized))
      : archivePosts;

    pagefindContainer.hidden = true;
    archiveResults.hidden = false;
    archiveResults.innerHTML = matches.length
      ? matches.map((post) => {
          const tags = post.tags.length ? ` · ${post.tags.map(tag => `#${tag}`).join(", ")}` : "";
          const category = post.category ? `${post.category} · ` : "";
          return `
            <li class="paper-post-item">
              <a href="${post.href}">
                <span class="paper-post-title">${post.title}</span>
                <span class="paper-post-description">${post.description}</span>
                <span class="paper-post-meta">${category}${post.date}${tags}</span>
              </a>
            </li>
          `;
        }).join("")
      : `<li class="paper-search-empty">No posts found.</li>`;
  }

  async function initPagefindSearch() {
    if (!pagefindContainer) return;
    if (pagefindContainer.querySelector("form")) return;

    const params = new URLSearchParams(window.location.search);
    if (params.get("archive") === "hidden") {
      renderArchive(params.get("q") ?? params.get("category") ?? params.get("tag") ?? "");
      return;
    }

    const search = new PagefindUI({
      element: "#pagefind-search",
      bundlePath: pagefindContainer.dataset.pagefindBundle ?? "/pagefind/",
      showImages: false,
      showSubResults: true,
      processTerm(term: string) {
        const nextParams = new URLSearchParams(window.location.search);
        if (term) nextParams.set("q", term);
        else nextParams.delete("q");
        history.replaceState(history.state, "", nextParams.toString() ? `?${nextParams}` : window.location.pathname);
        return term;
      },
    });

    const initial = params.get("q") ?? params.get("category") ?? params.get("tag") ?? "";
    if (initial) search.triggerSearch(initial);

    function triggerSearch(query: string) {
      const nextParams = new URLSearchParams(window.location.search);
      nextParams.set("q", query);
      history.replaceState(history.state, "", `?${nextParams}`);
      search.triggerSearch(query);
    }

    categoryButtons.forEach((button) => {
      button.addEventListener("click", () => triggerSearch(button.dataset.paperSearchCategory ?? ""));
    });
  }

  initPagefindSearch();
  document.addEventListener("astro:page-load", initPagefindSearch);
</script>
