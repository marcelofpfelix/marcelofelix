{
  "name": "marcelofelix",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "pnpm run dates:check && pnpm run compress:images:optional && astro check && astro build",
    "logo": "papyrus-logo public/logo.svg && papyrus-logo public/favicon.svg && papyrus-mobile-icons public && papyrus-manifest public/site.webmanifest",
    "cover:post": "papyrus-cover src/content/posts/hello-papyrus.md public/images/hello-papyrus.svg",
    "content:outline": "papyrus-content src/content/posts docs/content-structure.md",
    "dates:check": "papyrus-post-date check src/content/posts",
    "post:date": "papyrus-post-date",
    "compress:images": "papyrus-compress public/images",
    "compress:images:optional": "papyrus-compress --optional public/images",
    "test:lighthouse": "rm -rf lhci-report .lighthouseci && pnpm build && lhci autorun",
    "preview": "astro preview",
    "sync": "astro sync"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "astro": "^7.0.4",
    "astro-theme-papyrus": "file:../../papyrus/main",
    "rehype-callouts": "^2.2.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/markdown-remark": "^7.2.0",
    "@lhci/cli": "^0.15.1",
    "remark-definition-list": "^2.0.0",
    "typescript": "^5.9.3"
  }
}
